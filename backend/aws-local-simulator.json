{
  "services": {
    "dynamodb": true,
    "lambda": true,
    "apigateway": true
  },
  "ports": {
    "dynamodb": 8000,
    "lambda": 3001,
    "apigateway": 4567
  },
  "apigateway": {
    "apis": [
      {
        "name": "rag-http-api",
        "description": "Equivalente local da RagHttpApi do template.yaml",
        "endpoints": [
          { "path": "/chat", "method": "POST", "lambdaName": "rag-chat-handler" },
          { "path": "/chat", "method": "OPTIONS", "lambdaName": "rag-chat-handler" }
        ]
      }
    ]
  },
  "lambdas": [
    {
      "name": "rag-chat-handler",
      "runtime": "python3.12",
      "handler": "chat_handler.lambda_handler",
      "codePath": "src",
      "timeout": 60,
      "env": {
        "TABLE_NAME": "blog-table",
        "DYNAMODB_ENDPOINT": "http://localhost:8000",
        "AWS_PROFILE": "dev",
        "AWS_REGION": "us-east-1"
      }
    }
  ],
  "dynamodb": {
    "tables": [
      {
        "TableName": "blog-table",
        "KeySchema": [
          { "AttributeName": "id", "KeyType": "HASH" }
        ],
        "AttributeDefinitions": [
          { "AttributeName": "id", "AttributeType": "S" }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "VectorIndexes": [
          {
            "IndexName": "embedding-index",
            "VectorAttribute": { "AttributeName": "embedding" },
            "Dimensions": 1024,
            "DistanceFunction": "COSINE",
            "Projection": { "ProjectionType": "ALL" }
          }
        ]
      }
    ]
  }
}
